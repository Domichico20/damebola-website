# Copy this file to .env and fill in the secrets.
# Never commit .env. The setup script can create it for local development.

DATABASE_URL="file:../data/damebola.db"

# At least 32 random characters.
AUTH_SECRET=""
IP_HASH_SALT=""

ADMIN_EMAIL="Info@DameBolaApp.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# Leave SMTP blank until a mailbox is connected. Signups still save, and a copy is emailed to NOTIFY_EMAIL when SMTP works.
# GreenGeeks blocks outbound ports 25, 465, and 587. Use a provider that accepts another port, such as 2525.
SMTP_HOST=""
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DameBola <Info@DameBolaApp.com>"
NOTIFY_EMAIL="Info@DameBolaApp.com"

# Optional. If set, a new subscriber is also POSTed to this URL. No paid service is called otherwise.
EMAIL_MARKETING_WEBHOOK=""
EMAIL_MARKETING_TOKEN=""

NEXT_PUBLIC_SITE_URL="https://www.damebolaapp.com"
NEXT_PUBLIC_GA_ID=""
GOOGLE_SITE_VERIFICATION=""
